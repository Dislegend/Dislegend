<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }} | {{ shop.name }}</title>
  <meta name="description" content="{{ shop.meta_description | default: shop.name }}">
  {{ content_for_header }}
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
</head>
<body>
  <div class="page-wrapper">
    <header class="site-header">
      <div class="logo">{{ shop.name }}</div>
      <nav class="nav">
        {% for link in linklists.main-menu.links %}
          <a href="{{ link.url }}" class="nav__link">{{ link.title }}</a>
        {% endfor %}
      </nav>
      <div class="header-actions">
        <a href="/cart" class="btn btn--ghost">Sepet</a>
        <a href="/collections" class="btn">Koleksiyonlar</a>
      </div>
    </header>

    <main role="main" class="main">
      {{ content_for_layout }}
    </main>

    <footer class="site-footer">
      {% section 'footer-cta' %}
    </footer>
  </div>
  {{ content_for_footer }}
</body>
</html>
