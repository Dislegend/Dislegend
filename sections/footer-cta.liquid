<section class="footer-cta">
  <div class="container footer-cta__grid">
    <div class="footer-cta__text">
      <p class="footer-cta__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <form class="footer-cta__form" method="post" action="/contact#ContactFooter">
      <label class="sr-only" for="NewsletterEmail">E-posta adresi</label>
      <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="E-posta adresiniz" required>
      <button type="submit" class="btn">{{ section.settings.button_label }}</button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Alt Çağrı",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Üst Başlık",
      "default": "Özel teklifleri kaçırmayın"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Erken erişim ve üyeye özel indirimler"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Alt Başlık",
      "default": "E-posta listemize katılın, ilk siparişinizde indirim kazanın."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Buton Metni",
      "default": "Kaydol"
    }
  ],
  "presets": [
    {
      "name": "Alt Çağrı",
      "category": "Bülten"
    }
  ]
}
{% endschema %}
