<section class="feature-grid">
  <div class="container">
    <div class="section-heading">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="feature-grid__items">
      {% for block in section.blocks %}
        <div class="feature-card" {{ block.shopify_attributes }}>
          <div class="feature-card__icon">{{ block.settings.icon }}</div>
          <h3 class="feature-card__title">{{ block.settings.title }}</h3>
          <p class="feature-card__text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Öne Çıkan Özellikler",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Mükemmel Deneyim için Tasarlandı"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Alt Başlık",
      "default": "Koleksiyonlarımızdaki her parça, şıklık ve performansı birleştirir."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Özellik",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Simge (emoji veya kısa metin)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Başlık",
          "default": "Seçkin Malzemeler"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Metin",
          "default": "Uzun ömürlü ve nefes alan kumaşlar, her gün konfor."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Öne Çıkan Özellikler",
      "category": "Özellikler",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
